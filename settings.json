{
  "permissions": {
    "defaultMode": "auto"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // empty' | { read -r f; case \"$f\" in \"$HOME\"/Obsedian/*) ;; *.md|*.markdown) \"$HOME/.local/bin/mdformat\" --wrap=keep --number \"$f\" || true ;; esac; }"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/auto-session-title.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh",
    "padding": 0
  },
  "enabledPlugins": {
    "context7@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "context-mode@context-mode": true,
    "codex@openai-codex": true,
    "postman@claude-plugins-official": true,
    "obsidian@obsidian-skills": true
  },
  "extraKnownMarketplaces": {
    "context-mode": {
      "source": {
        "source": "github",
        "repo": "mksglu/context-mode"
      },
      "autoUpdate": true
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "obsidian-skills": {
      "source": {
        "source": "github",
        "repo": "kepano/obsidian-skills"
      }
    },
    "mattpocock": {
      "source": {
        "source": "github",
        "repo": "mattpocock/skills"
      }
    },
    "devfast": {
      "source": {
        "source": "github",
        "repo": "devdotfast/whiteboard"
      }
    },
    "ui-ux-pro-max-skill": {
      "source": {
        "source": "github",
        "repo": "nextlevelbuilder/ui-ux-pro-max-skill"
      },
      "autoUpdate": true
    },
    "understand-anything": {
      "source": {
        "source": "github",
        "repo": "Egonex-AI/Understand-Anything"
      }
    }
  },
  "effortLevel": "high",
  "skipDangerousModePermissionPrompt": true,
  "editorMode": "vim",
  "verbose": false,
  "agentPushNotifEnabled": false,
  "inputNeededNotifEnabled": false,
  "skipAutoPermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "useAutoModeDuringPlan": true,
  "switchModelsOnFlag": false,
  "remoteControlAtStartup": false,
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "language": "türkçe",
  "worktree": {
    "baseRef": "fresh"
  },
  "model": "opus",
  "minimumVersion": "2.1.183",
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "xhigh"
    },
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "timeFormat": "24-hour",
  "enableArtifact": false,
  "autoMode": {
    "soft_deny": [
      "$defaults",
      "Bash(psql:* prod*)"
    ]
  }
}
